# Embeds the .hex vector files as C strings; g1_vector_load() finds a packet by its title line.

set(body "/* generated by tests/unit/common/gen_vectors.cmake; do not edit */\n")
string(APPEND body "#include <stddef.h>\n\n")

set(table "")
set(i 0)
foreach(f ${FILES})
  get_filename_component(fname ${f} NAME)
  file(READ ${f} hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND body "/* ${fname} */\nstatic const char g1_vec_${i}[] = {${bytes}0x00};\n")
  string(APPEND table "\tg1_vec_${i},\n")
  math(EXPR i "${i} + 1")
endforeach()

string(APPEND body "\nconst char *const g1_vector_files[] = {\n${table}\tNULL,\n};\n")
string(APPEND body "const size_t g1_vector_file_count = ${i};\n")

if(EXISTS ${OUT})
  file(READ ${OUT} old)
else()
  set(old "")
endif()
if(NOT old STREQUAL body)
  file(WRITE ${OUT} "${body}")
endif()
