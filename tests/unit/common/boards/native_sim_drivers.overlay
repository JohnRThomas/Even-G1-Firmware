/*
 * Driver suites (G1_UNIT_DRIVERS): the firmware's devicetree labels on emulated hardware. A chip
 * whose emulator the suite does not pick (g1_unit_emul) NAKs every transfer, a valid "chip missing"
 * setup. A fake sensor driver's node needs its device in every driver suite (i2c_emul links every
 * child), so emul.cmake always compiles it. Not provided yet: uart0, pdm0, ipc0.
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/* the label moves to the emulated NOR flash below */
/delete-node/ &mx25r64;

/ {
	/* 32 MiB, as the lens' MX25U256 */
	mx25r64: mx25r6435f {
		compatible = "vnd,g1-unit-nor-flash";
		size = <0x2000000>;
	};

	gpio1: gpio@900 {
		status = "okay";
		compatible = "zephyr,gpio-emul";
		reg = <0x900 0x4>;
		rising-edge;
		falling-edge;
		high-level;
		low-level;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <16>;
	};

	gpio_keys {
		compatible = "gpio-keys";
		sw0: sw0 {
			gpios = <&gpio1 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "SW0";
		};
		sw1: sw1 {
			gpios = <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "SW1";
		};
	};

	/* TWIM1 on the lens */
	i2c1: i2c@1100 {
		status = "okay";
		compatible = "zephyr,i2c-emul-controller";
		clock-frequency = <I2C_BITRATE_FAST>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x1100 4>;

		opt3007: opt3001@45 {
			compatible = "vnd,g1-unit-i2c-chip";
			reg = <0x45>;
		};

		/* ST25DV04KC: 0x53 user / dynamic / mailbox, 0x57 system area */
		st25dv: st25dv@53 {
			compatible = "vnd,g1-unit-i2c-chip";
			reg = <0x53>;
		};
		st25dv_sys: st25dv@57 {
			compatible = "vnd,g1-unit-i2c-chip";
			reg = <0x57>;
		};

		pmic: pmic@6b {
			compatible = "vnd,g1-unit-npm1300";
			reg = <0x6b>;

			pmic_regulators: regulators {
				compatible = "vnd,g1-unit-npm1300-regulator";

				pmic_buck1: BUCK1 {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <3300000>;
				};
				pmic_buck2: BUCK2 {
					regulator-min-microvolt = <1000000>;
					regulator-max-microvolt = <3300000>;
					regulator-init-microvolt = <1200000>;
				};
				pmic_ldo1: LDO1 {
					regulator-min-microvolt = <1000000>;
					regulator-max-microvolt = <3300000>;
				};
				pmic_ldo2: LDO2 {
					regulator-min-microvolt = <1000000>;
					regulator-max-microvolt = <3300000>;
				};
			};

			/* reset-gpios omitted: no nPM1300 GPIO controller here */
			pmic_wdt: watchdog {
				compatible = "nordic,npm1300-wdt";
			};

			pmic_charger: charger {
				compatible = "vnd,g1-unit-charger";
				current-microamp = <40000>;
			};
		};
	};

	/* TWIM2 on the lens */
	i2c2: i2c@1200 {
		status = "okay";
		compatible = "zephyr,i2c-emul-controller";
		clock-frequency = <I2C_BITRATE_FAST>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x1200 4>;

		/* INT drives sw0 */
		aw93203: aw93203@12 {
			compatible = "vnd,g1-unit-i2c-chip";
			reg = <0x12>;
		};

		lsm6dso: lsm6dso@6b {
			compatible = "vnd,g1-unit-lsm6dso";
			reg = <0x6b>;
		};
	};
};

/*
 * NFC field voltage. 0.6 V reference and gain 1/6 give 3.6 V full scale, as on the lens.
 * adc_emul_const_value_set(adc0, 3, mV) sets the pin.
 */
&adc0 {
	#address-cells = <1>;
	#size-cells = <0>;
	nchannels = <8>;
	ref-internal-mv = <600>;

	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

/ {
	zephyr,user {
		io-channels = <&adc0 3>;
	};
};
