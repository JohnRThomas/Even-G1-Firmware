# Embeds the golden images in a C file:
# cmake -DOUT=<file.c> -DFILES=<a.pbm;b.pgm> -P gen_goldens.cmake

set(body "/* generated by tests/unit/gui/gen_goldens.cmake; do not edit */\n")
string(APPEND body "#include <stddef.h>\n#include <stdint.h>\n\n")
string(APPEND body "struct gui_golden_file {\n\tconst char *name;\n\tconst uint8_t *data;\n\tsize_t len;\n};\n\n")

set(table "")
set(i 0)
foreach(f ${FILES})
  get_filename_component(fname ${f} NAME)
  file(READ ${f} hex HEX)
  string(LENGTH "${hex}" nhex)
  math(EXPR nbytes "${nhex} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND body "/* ${fname} */\nstatic const uint8_t gui_golden_${i}[] = {${bytes}};\n")
  string(APPEND table "\t{\"${fname}\", gui_golden_${i}, ${nbytes}},\n")
  math(EXPR i "${i} + 1")
endforeach()

string(APPEND body "\nconst struct gui_golden_file gui_golden_files[] = {\n${table}\t{NULL, NULL, 0},\n};\n")
string(APPEND body "const size_t gui_golden_file_count = ${i};\n")

# write only on change
if(EXISTS ${OUT})
  file(READ ${OUT} old)
else()
  set(old "")
endif()
if(NOT old STREQUAL body)
  file(WRITE ${OUT} "${body}")
endif()
