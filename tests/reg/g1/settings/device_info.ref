# With the glasses not worn, the app reads the identity and settings of both lenses and switches ANCS on. It then
# sends the slave a notification whitelist and a notification, reads the unread count, clears the notification and
# reads the count again.

action(B, phone_on(),
       event(B, "pairing: complete, link encrypted, bonded"),
       recv(B, "4D C9"),
       recv(B, "2C 66"),
       # BLE paired
       recv(B, "F5 11"),
       # wear state reported on connect
       recv(B, "F5 06"),
       # charging state, within 8 s on a good schedule
       recv(B, "F5 09"),
       within=8, label="phone_on")

# read the MAC address (tests/unit/vectors: 0x2d_mac_get)
action(B, send('2D'),
       # the master's MAC, then the slave's
       recv(M, "2D 67 D9 70 29 9E A4 E9 85 EB 5B 0B 65 F2"),
       # the slave knows its own
       recv(S, "2D 67 .. .. .. .. .. .. 85 EB 5B 0B 65 F2"))
# glasses serial number, as text (tests/unit/vectors: 0x33_glasses_sn_get)
action(B, send('33'), recv(B, "'33S100demoglasses'"))
# device serial number, as text (tests/unit/vectors: 0x34_device_sn_get)
action(B, send('34'), recv(B, "'44S100demodevice'"))
# ESB channel 34 (tests/unit/vectors: 0x35_esb_channel_get)
action(B, send('35'), recv(B, "35 C9 22"))
# no notification yet (tests/unit/vectors: 0x36_notification_count_get)
action(B, send('36'), recv(B, "36 C9 00"))
# ANCS off (tests/unit/vectors: 0x38_ancs_enable_get)
action(B, send('38'), recv(B, "38 C9 00"))
action(B, send('49'), recv(B, "49 C9"))
# ANCS off (write acknowledged)
action(B, send('14 00'), recv(B, "14 C9"))
# still off (tests/unit/vectors: 0x38_ancs_enable_get)
action(B, send('38'), recv(B, "38 C9 00"))
# ANCS on (tests/unit/vectors: 0x14_ancs_enable)
action(B, send('14 01'), recv(B, "14 C9"))
# on after 0x14 01 (tests/unit/vectors: 0x38_ancs_enable_get)
action(B, send('38'), recv(B, "38 C9 01"))

# the notification whitelist to the slave, in two chunks
# notification whitelist (Gadgetbridge, Discord, Gmail), chunk 1 of 2 (tests/unit/vectors: 0x04_whitelist_chunk1)
action(S, send('04 02 00 7B 22 63 61 6C 65 6E 64 61 72 5F 65 6E 61 62 6C 65 22 3A 74 72 75 65 2C 22 63 61 6C 6C 5F 65 6E 61 62 6C 65 22 3A 74 72 75 65 2C 22 6D 73 67 5F 65 6E 61 62 6C 65 22 3A 74 72 75 65 2C 22 69 6F 73 5F 6D 61 69 6C 5F 65 6E 61 62 6C 65 22 3A 74 72 75 65 2C 22 61 70 70 22 3A 7B 22 6C 69 73 74 22 3A 5B 7B 22 69 64 22 3A 22 6E 6F 64 6F 6D 61 69 6E 2E 66 72 65 65 79 6F 75 72 67 61 64 67 65 74 2E 67 61 64 67 65 74 62 22 2C 22 6E 61 6D 65 22 3A 22 47 61 64 67 65 74 62 72 69 64 67 65 22 7D 2C 7B 22 69 64 22 3A 22 63 6F 6D 2E 64 69 73 63'), recv(S, "04 CB"))
# notification whitelist, chunk 2 of 2 (tests/unit/vectors: 0x04_whitelist_chunk2)
action(S, send('04 02 01 6F 72 64 22 2C 22 6E 61 6D 65 22 3A 22 44 69 73 63 6F 72 64 22 7D 2C 7B 22 69 64 22 3A 22 63 6F 6D 2E 67 6F 6F 67 6C 65 2E 61 6E 64 72 6F 69 64 2E 67 6D 22 2C 22 6E 61 6D 65 22 3A 22 47 6D 61 69 6C 22 7D 5D 2C 22 65 6E 61 62 6C 65 22 3A 74 72 75 65 7D 7D'), recv(S, "04 C9"))

# a notification to the slave, in two chunks. The slave hands it to the master over ESB: without the link
# nothing is shown or counted.
# a Gadgetbridge notification, "Even G1_87": "Connected: Battery 98%, 100%, 10%", chunk 1 of 2 (tests/unit/vectors: 0x4b_notification_chunk1)
action(S, send('4B 00 02 00 7B 22 6E 63 73 5F 6E 6F 74 69 66 69 63 61 74 69 6F 6E 22 3A 7B 22 6D 73 67 5F 69 64 22 3A 34 31 33 2C 22 61 63 74 69 6F 6E 22 3A 30 2C 22 61 70 70 5F 69 64 65 6E 74 69 66 69 65 72 22 3A 22 6E 6F 64 6F 6D 61 69 6E 2E 66 72 65 65 79 6F 75 72 67 61 64 67 65 74 2E 67 61 64 67 65 74 62 22 2C 22 74 69 74 6C 65 22 3A 22 45 76 65 6E 20 47 31 5F 38 37 22 2C 22 73 75 62 74 69 74 6C 65 22 3A 22 22 2C 22 6D 65 73 73 61 67 65 22 3A 22 43 6F 6E 6E 65 63 74 65 64 3A 20 42 61 74 74 65 72 79 20 39 38 25 2C 20 31 30 30 25 2C 20 31 30 25 22'), recv(S, "4B CB"))
# the notification, chunk 2 of 2 (tests/unit/vectors: 0x4b_notification_chunk2)
action(S, send('4B 00 02 01 2C 22 74 69 6D 65 5F 73 22 3A 31 37 36 32 38 39 39 39 35 39 2C 22 64 61 74 65 22 3A 22 32 30 32 35 2D 31 31 2D 31 31 20 31 34 3A 32 35 3A 35 39 22 2C 22 64 69 73 70 6C 61 79 5F 6E 61 6D 65 22 3A 22 47 61 64 67 65 74 62 72 69 64 67 65 22 7D 7D'),
       recv(S, "4B C9"),
       # the notification (unread mark) on both panels
       display(B, shows("unread_mark")),
       within=4)
# one unread notification (tests/unit/vectors: 0x36_notification_count_get)
action(B, send('36'), recv(B, "36 C9 01"))
# the notification cleared
action(S, send('4C 00 00 01 9D'), recv(S, "4C C9"))
# the lenses take it off about half a second after the acknowledgement and nothing tells the phone when
wait(1.6)
# none unread (tests/unit/vectors: 0x36_notification_count_get)
action(B, send('36'), recv(B, "36 C9 00"))

# over the whole run
never("fatal")
never("boot", after=1)
link_up()
