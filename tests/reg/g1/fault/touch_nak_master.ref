# The master's touch controller NAKs every I2C transaction from power-on. The master must keep running without its
# touch bar, the slave's still works and the dashboard comes up when the glasses are donned.

# from power-up, before the firmware boots
action(M, TOUCH + "FaultNak true")
at(5)
# dashboard (no phone yet: Mon 01/01 00:00)
action(B, gesture("don"), display(B, settles_to("dashboard_unpaired")), within=7)
mark("dashboard")
at(15)
# a tap on each lens
action(B, TAP)
at(16.5)
action(B, TAP)
at(18.5)
check(S, "sysbus.twim1.npm1300 WatchdogResetCount", equals="0x00000000")
check(M, "sysbus.twim1.npm1300 WatchdogResetCount", equals="0x00000000")
check(M, "sysbus.twim2.lsm6dso AccelerometerEnabled", equals="True")
# only the master runs the IMU
check(S, "sysbus.twim2.lsm6dso AccelerometerEnabled", equals="False")
# The master's touch controller takes nothing: unconfigured, its taps are dropped by the model.
check(M, "sysbus.twim2.touch ConfigWriteCount", equals="0x00000000")
check(M, "sysbus.twim2.touch EventsArmed", equals="False")
check(M, "sysbus.twim2.touch PressesDelivered", equals="0x00000000")
# The slave's touch bar works as usual.
check(S, "sysbus.twim2.touch ConfigWriteCount", equals="0x0000002D")
check(S, "sysbus.twim2.touch CommitWritten", equals="True")
check(S, "sysbus.twim2.touch MagicWritten", equals="True")
check(S, "sysbus.twim2.touch EventsArmed", equals="True")
# the taps at 15 s and 16.5 s
check(S, "sysbus.twim2.touch PressesDelivered", equals="0x00000002")
at(19)
# the master survives its dead touch controller
never("fatal")
never("boot", after=1)
# no phone: no event leaves the glasses
quiet(B, "F5")
# nothing redrawn once the dashboard is up: it stays up, a tap without a phone changes nothing
never("frame ", after=("dashboard", 0))
