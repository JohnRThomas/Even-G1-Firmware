# The master's NFC tag starts NAKing every I2C transaction with the dashboard up. The glasses must still run: the
# dashboard comes up when donned and both touch bars work.

# dashboard (no phone yet: Mon 01/01 00:00)
action(B, gesture("don"), display(B, settles_to("dashboard_unpaired")), within=7)
mark("dashboard")
# the fault, once the dashboard is up (the scenario had it at 10 s)
action(M, NFC + "FaultNak true")
# a tap on each lens: a single click to the firmware, which with no phone changes nothing on the panels
action(B, TAP, quiet(B, "frame "), within=1.5)
# The firmware next writes to the tag 15 s after power-on (nfc_wlc_process(); its write at 5 s was before the
# fault): the dashboard stays as it is for the 10 s until that write has met the fault.
expect(quiet(B, "frame "), within=10)
# a second tap on each lens, after it
action(B, TAP, quiet(B, "frame "), within=1.5)
include("common/fault")
include("common/fault_touch")
check(M, "sysbus.twim2.lsm6dso AccelerometerEnabled", equals="True")
# the two taps on each lens
check(B, "sysbus.twim2.touch PressesDelivered", equals="0x00000002")
# nothing redrawn once the dashboard is up: it stays up, a tap without a phone changes nothing
never("frame ", after=("dashboard", 0))
