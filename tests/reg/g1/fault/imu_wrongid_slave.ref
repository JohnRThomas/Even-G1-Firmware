# The slave's IMU answers its id with a wrong value from power-on. The slave never uses its IMU, so the dashboard
# comes up on both lenses and both touch bars work.

# from power-up, before the firmware boots
action(S, IMU + "FaultWrongId true")
# dashboard (no phone yet: Mon 01/01 00:00)
action(B, gesture("don"), display(B, settles_to("dashboard_unpaired")), within=7)
mark("dashboard")
# a tap on each lens
action(B, TAP)
wait(11.2)
action(B, TAP)
wait(0.3)
include("common/fault")
include("common/fault_touch")
check(M, "sysbus.twim2.lsm6dso AccelerometerEnabled", equals="True")
# the two taps on each lens
check(B, "sysbus.twim2.touch PressesDelivered", equals="0x00000002")
# nothing redrawn once the dashboard is up: it stays up, a tap without a phone changes nothing
never("frame ", after=("dashboard", 0))
