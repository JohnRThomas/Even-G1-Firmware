# The slave's PMIC NAKs every I2C transaction from power-on. The glasses must still run: when donned the master shows
# the dashboard (the slave's panel has no supplies without its PMIC), and both touch bars work.

# from power-up, before the firmware boots
action(S, NPM + "FaultNak true")
# The panel's supplies are the PMIC's (BUCK2, LDSW1): a lens that cannot talk to its PMIC cannot switch them on,
# so its panel stays dark whatever the firmware draws. The other lens shows the dashboard.
# dashboard (no phone yet: Mon 01/01 00:00)
action(B, gesture("don"), display(M, settles_to("dashboard_unpaired")), display(S, blank), within=7)
mark("dashboard")
# a tap on each lens and a second one 1.5 s later (two single clicks, not a double click): with no phone a
# click changes nothing on the panels
action(B, TAP, quiet(B, "frame "), within=1.5)
action(B, TAP, quiet(B, "frame "), within=1.5)
include("common/fault")
check(M, "sysbus.twim2.lsm6dso AccelerometerEnabled", equals="True")
# The master's touch bar works as usual.
check(M, "sysbus.twim2.touch ConfigWriteCount", equals="0x0000002D")
check(M, "sysbus.twim2.touch CommitWritten", equals="True")
check(M, "sysbus.twim2.touch MagicWritten", equals="True")
check(M, "sysbus.twim2.touch EventsArmed", equals="True")
# the two taps
check(M, "sysbus.twim2.touch PressesDelivered", equals="0x00000002")
# The slave's: queried here, asserted at the end (the known failure there).
check(S, "sysbus.twim2.touch ConfigWriteCount")
check(S, "sysbus.twim2.touch CommitWritten")
check(S, "sysbus.twim2.touch MagicWritten")
check(S, "sysbus.twim2.touch EventsArmed")
check(S, "sysbus.twim2.touch PressesDelivered")
# nothing redrawn once the dashboard is up: it stays up, a tap without a phone changes nothing
never("frame ", after=("dashboard", 0))
# The slave's touch bar should work as the master's does, the two taps delivered.
known_failure("component_init() gives up before aw93203_init() when the PMIC does not answer (src/main.c)",
              together(state("sysbus.twim2.touch ConfigWriteCount", equals="0x0000002D", lens=S),
                       state("sysbus.twim2.touch CommitWritten", equals="True", lens=S),
                       state("sysbus.twim2.touch MagicWritten", equals="True", lens=S),
                       state("sysbus.twim2.touch EventsArmed", equals="True", lens=S),
                       state("sysbus.twim2.touch PressesDelivered", equals="0x00000002", lens=S)))
