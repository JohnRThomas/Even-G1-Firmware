# With the glasses worn and the phone on without heartbeats, the app sends the upgrade control command to both
# lenses. The firmware must ack, close the dashboard and not drop the silent phone, which leaves and reconnects with
# the bond's key.

action(B, phone_on(hb=0),
       recv(B, "4D C9"),
       # the master's own version: this soon after power-on it has not got the slave's yet (hw/battery_sweep
       # asserts both)
       recv(M, "2C 66 .. .. F9 80 19 01 06 07"),
       recv(S, "2C 66 .. .. F9 80 19 00 00 00 01 06 07"),
       # BLE paired
       recv(B, "F5 11"),
       within=8)

# Turn off the mic on head up.
action(B, send('26 06 00 00 08 01'), recv(B, "26 06 00 .. 08 C9"))

# put on: head up, the dashboard opens on both lenses. Worn and the charging state are reported once per lens; the
# charging state is not reported any more once the lenses are in upgrade mode, so the command waits for it.
action(B, gesture("don"),
       recv(M, "F5 02"),
       recv(B, "F5 1E"),
       recv(B, "F5 06"),
       recv(B, "F5 09 00"),
       # dashboard
       display(B, settles_to("dashboard")),
       within=6)

# upgrade mode: acked, the dashboard closes on both lenses
# enter upgrade mode (tests/unit/vectors: 0x17_upgrade_mode)
action(B, send('17'),
       recv(B, "17 C9"), recv(B, "F5 1F"), display(B, settles_to("blank")))
# the phone stays silent for 36 s and is not dropped; then it closes the link itself
expect(quiet(B, "disconnected"), within=35.5)
action(M, PHONE_OFF, event(M, "disconnected: the phone closed the link"), within=1)

# the phone comes back at once (the lens advertises again about 1 s after the link closed): encrypted with the
# bond, MTU exchanged, the master reports the link again
action(M, PHONE_ON, event(M, "link encrypted with the bond's key"))
action(M, send('4D FB'), recv(M, "4D C9"), recv(M, "F5 11"))
check(B, "sysbus.vcentral Connected", equals="True")
check(B, "sysbus.vcentral Encrypted", equals="True")
check(B, "sysbus.vcentral Bonded", equals="True")
check(B, "sysbus.vcentral AttMtu", equals="0x000000FB")

# over the whole run
never("fatal")
never("boot", after=1)
