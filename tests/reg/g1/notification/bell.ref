# With the dashboard up, the app sets notification auto display, sends the app whitelist and reads both back, then
# sends a notification from a whitelisted app. The dashboard must show the bell with one message on both lenses, and
# no message again once the app clears it.

at(12)
action(B, phone_on(),
       event(B, "pairing: complete, link encrypted, bonded"),
       recv(B, "2C 66"), recv(B, "4D C9"),
       # BLE paired
       recv(B, "F5 11"),
       within=8, label="phone_on")

# put on (the app's settings follow at once, so the dashboard is waited for below): auto display on (06) on each
# lens, read back on the slave
mark("don")
action(B, gesture("don"))
action(S, send('4F 01 06'), recv(S, "4F C9 01"))
action(M, send('4F 01 06'), recv(M, "4F C9 01"))
action(S, send('3C'), recv(S, "3C C9 01 06"))

# the whitelist: the first chunk is acknowledged as partial (CB), the last as complete (C9); read back as
# 13 chunks 2E 0D 00..0C
wait(0.9)
# notification whitelist (Gadgetbridge, Chat) in two chunks
action(S, [send('04 02 00 7B 22 63 61 6C 65 6E 64 61 72 5F 65 6E 61 62 6C 65 22 3A 74 72 75 65 2C 22 63 61 6C 6C 5F 65 6E 61 62 6C 65 22 3A 74 72 75 65 2C 22 6D 73 67 5F 65 6E 61 62 6C 65 22 3A 74 72 75 65 2C 22 69 6F 73 5F 6D 61 69 6C 5F 65 6E 61 62 6C 65 22 3A 74 72 75 65 2C 22 61 70 70 22 3A 7B 22 6C 69 73 74 22 3A 5B 7B 22 69 64 22 3A 22 6E 6F 64 6F 6D 61 69 6E 2E 66 72 65 65 79 6F 75 72 67 61 64 67 65 74 2E 67 61 64 67 65 74 62 22 2C 22 6E 61 6D 65 22 3A 22 47 61 64 67 65 74 62 72 69 64 67 65 22 7D 2C 7B 22 69 64 22 3A 22 63 6F 6D 2E 65 78 61 6D'), send('04 02 01 70 6C 65 2E 63 68 61 74 22 2C 22 6E 61 6D 65 22 3A 22 43 68 61 74 22 7D 5D 2C 22 65 6E 61 62 6C 65 22 3A 74 72 75 65 7D 7D')],
       sequence(recv(S, "04 CB"), recv(S, "04 C9")), within=3.5)
wait(1.2)
action(S, send('2E'), recv(S, "2E 0D 00"), recv(S, "2E 0D", count=13), recv(S, "2E 0D 0C"))

# both worn, the master head up, the dashboard opens on both lenses within 6 s of the don and the master streams
# the mic (F1 packets) while it is up, which the app ignores
# dashboard, no message
expect(recv(B, "F5 1E"), display(B, settles_to("dashboard")), audio(M), within=3)
after("don", recv(B, "F5 06"), recv(M, "F5 02"), within=6)

# the notification: partial then complete ack; the dashboard shows one message on both lenses
# notification 7 from Chat in two chunks: "Lunch at noon?", "Meet at the cafe on the corner."
action(S, [send('4B 00 02 00 7B 22 6E 63 73 5F 6E 6F 74 69 66 69 63 61 74 69 6F 6E 22 3A 7B 22 6D 73 67 5F 69 64 22 3A 37 2C 22 61 63 74 69 6F 6E 22 3A 30 2C 22 61 70 70 5F 69 64 65 6E 74 69 66 69 65 72 22 3A 22 63 6F 6D 2E 65 78 61 6D 70 6C 65 2E 63 68 61 74 22 2C 22 74 69 74 6C 65 22 3A 22 4C 75 6E 63 68 20 61 74 20 6E 6F 6F 6E 3F 22 2C 22 73 75 62 74 69 74 6C 65 22 3A 22 22 2C 22 6D 65 73 73 61 67 65 22 3A 22 4D 65 65 74 20 61 74 20 74 68 65 20 63 61 66 65 20 6F 6E 20 74 68 65 20 63 6F 72 6E 65 72 2E 22 2C 22 74 69 6D 65 5F 73 22 3A 31 37 36 32 38'), send('4B 00 02 01 39 39 39 35 39 2C 22 64 61 74 65 22 3A 22 32 30 32 35 2D 31 31 2D 31 31 20 32 32 3A 32 35 3A 35 39 22 2C 22 64 69 73 70 6C 61 79 5F 6E 61 6D 65 22 3A 22 43 68 61 74 22 7D 7D')],
       # dashboard, bell with 1 message
       sequence(recv(S, "4B CB"), recv(S, "4B C9")), display(B, settles_to("dashboard_1msg")), within=3.5)

# the master's status: a message pending, worn
action(M, send('22 05 00 01 01'), recv(M, "22 05 00 01 01 01 01 00"))

# clearing message 7 on the slave: ack, and the dashboard shows no message again on both lenses
# dashboard, no message
action(S, send('4C 00 00 00 07'), recv(S, "4C C9"), display(B, settles_to("dashboard")))

# the master's status after the clear: none pending
action(M, send('22 05 00 02 01'), recv(M, "22 05 00 02 01 00 01 00"))

# over the whole run
never("fatal")
never("boot", after=1)
link_up()
# the charging state, reported once per lens
recv(B, "F5 09")
# the dashboard opened once per lens
recv(B, "F5 1E")
audio(M)
