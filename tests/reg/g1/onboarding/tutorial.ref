# The app starts the onboarding tutorial and steps through the pages. The glasses must show each page.

# the session: the head down follows the don at once and takes its place, so the glasses are worn with the head
# level and no dashboard is up when the phone connects with the app's heartbeat off; the app's 0x2C
# keep-alive is sent by the lines below
action(B, gesture("don"))
action(B, gesture("head_down"))
action(B, phone_on(hb=0),
       event(B, "pairing: complete, link encrypted, bonded"),
       recv(B, "2C 66"), recv(B, "4D C9"),
       # the link event once per lens (link_up times it)
       recv(B, "F5 11"),
       within=8, label="phone_on")

# start: acknowledged with the sub-command echoed, page 1 is up on both lenses
# onboarding start (tests/unit/vectors: 0x1f_onboarding_start)
action(B, send('1F 01 01'),
       recv(B, "1F 01 C9 01"),
       # onboarding 1/6 "Welcome. Even G1 is connected."
       display(B, settles_to("onboarding_1")),
       within=1)
# the two 0x12 probes are acknowledged (with and without the trailing byte)
action(B, send('1F 12 00'), recv(B, "1F 12 C9 00"), within=0.9)
action(B, send('1F 12'), recv(B, "1F 12 C9"), within=0.9)
# each step is acknowledged and shows its page (page 3 animates: the frame is one of its states)
action(B, send('1F 0C 02'),
       recv(B, "1F 0C C9 02"),
       # onboarding 2/6 "Follow the instructions on your phone."
       display(B, settles_to("onboarding_2")),
       within=2)
# the 10 s keep-alive is answered with the status
action(B, send('2C 01'), recv(B, "2C 66"))
action(B, send('1F 08 03'),
       recv(B, "1F 08 C9 03"),
       # onboarding 3/6 "Let's get started." (animated)
       display(B, shows("onboarding_3")),
       within=3)
action(B, send('1F 07 04'),
       recv(B, "1F 07 C9 04"),
       # onboarding 5/6 "Follow the instructions on your phone."
       display(B, settles_to("onboarding_5")),
       within=3)
action(B, send('1F 02 05'),
       recv(B, "1F 02 C9 05"),
       # onboarding 6/6 "Setup complete."
       display(B, settles_to("onboarding_6")),
       within=3)
# finish: acknowledged, both lenses blank
action(B, send('2C 01'), recv(B, "2C 66"))
action(B, send('1F 0A 06'), recv(B, "1F 0A C9 06"), display(B, blank), within=3)

# over the whole run
never("fatal")
never("boot", after=1)
link_up()
# worn (donned before the phone), reported once
recv(B, "F5 06")
# the charging state, reported once (the run goes on until it has come)
after("phone_on", recv(B, "F5 09"), within=8)
# no head up ...
quiet(B, "F5 02")
# ... head down ...
quiet(B, "F5 03")
# ... dashboard close
quiet(B, "F5 1F")
