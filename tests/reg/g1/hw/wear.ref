# The app switches wear detection on and reads it back, then the glasses are taken off and put on again. They must
# report each change as an event and in the answer to the state query.

# The phone connects; each lens reports the link and, a round of its sensor loop later, worn (the rest pose counts
# as worn): the glasses are taken off only after that.
action(B, phone_on(), recv(B, "4D C9"), recv(B, "F5 11"), recv(B, "F5 06"), within=8, label="phone_on")
# Wear detection on, read back as on.
action(B, send('27 01'), recv(B, "27 C9"))
action(B, send('3A'), recv(B, "3A C9 01"))
# Taken off: not worn on both lenses; 0x2B reports display mode 0x0A, wear event 07.
# A lens says so up to 4.5 s after the signal drops: its network core reads the signal once a second and reports
# the third low reading in a row (up to 3 s), and its application core looks at the report on its next round (one
# about every 1.3 s).
action(B, "sysbus.radio RssiSample 30", recv(B, "F5 07"), within=5)
action(B, send('2B'), recv(B, "2B 69 0A 07"))
# Put on again: worn on both lenses; 0x2B reports wear event 06. The first high reading is reported: up to 2.5 s.
action(B, "sysbus.radio RssiSample 60", recv(B, "F5 06"))
action(B, send('2B'), recv(B, "2B 69 0A 06"))

# The links are still up at the end.
check(B, "sysbus.vcentral Connected", equals="True")
check(B, "sysbus.vcentral Encrypted", equals="True")
check(B, "sysbus.vcentral Bonded", equals="True")
check(B, "sysbus.vcentral AttMtu", equals="0x000000FB")

# over the whole run
never("fatal")
never("boot", after=1)
link_up()
# never worn with the head up: the panels stay blank
display(B, blank)
# the charging state, once per lens
recv(B, "F5 09")
# Worn is reported exactly twice per lens over the run: once after the phone connects (the rest pose counts
# as worn), once when put on again.
recv(B, "F5 06", count=2)
