# With the glasses worn and the phone on, the master's battery temperature is driven to 65 C. The glasses must
# report the abnormal temperature, close the dashboard on both lenses and report no head gestures until the app sets
# the display mode again.

action(B, phone_on(),
       recv(B, "4D C9"),
       # the master's own version: this soon after power-on it has not got the slave's yet (hw/battery_sweep
       # asserts both)
       recv(M, "2C 66 .. .. F9 80 19 01 06 07"),
       recv(S, "2C 66 .. .. F9 80 19 00 00 00 01 06 07"),
       # BLE paired
       recv(B, "F5 11"),
       within=8)

# Turn off the mic on head up.
action(B, send('26 06 00 00 08 01'), recv(B, "26 06 00 .. 08 C9"))

# put on: head up, the dashboard opens on both lenses
action(B, gesture("don"),
       recv(M, "F5 02"),
       recv(B, "F5 1E"),
       recv(B, "F5 06"),
       recv(B, "F5 09 00"),
       # dashboard
       display(B, settles_to("dashboard")),
       within=6)

# 65 C: abnormal temperature
action(M, NPM + "BatteryTemperatureCelsius 65",
       # abnormal temperature
       recv(M, "F5 04"),
       # the slave gets sync command 4: its task ended
       recv(S, "F5 00"),
       # the dashboard closes on both lenses
       recv(B, "F5 1F"), display(B, settles_to("blank")))
# display mode 0x0C: abnormal temperature
action(B, send('2B'), recv(B, "2B 69 0C 06"))
# 2C 01: the status; debug string "#v": battery level, voltage, current and temperature, as text
action(M, [send('2C 01'), send('23 76')],
       # 0x41: 65 C
       recv(M, "2C 66 .. .. F9 80 41"),
       recv(M, "'B:.., V:449, A:0, T:65'"))

# back to 25 C: the mode stays until the app clears it; head gestures meanwhile are not reported
action(M, NPM + "BatteryTemperatureCelsius 25")
action(B, pose(LEVEL), quiet(M, any_of("F5 02", "F5 03")))
action(B, pose(UP81), quiet(M, any_of("F5 02", "F5 03")))
action(B, send('2B'), recv(B, "2B 69 0C 06"))

# the app sets the display mode: "Activated", then the dashboard comes up as the head is still up
action(B, send('03 0A 00'),
       recv(B, "03 C9"),
       # "Activated"
       display(B, shows("silent_off")),
       recv(M, "F5 02"), recv(B, "F5 1E"),
       # dashboard
       display(B, settles_to("dashboard")),
       within=5)
action(B, pose(LEVEL), recv(M, "F5 03"), recv(B, "F5 1F"), display(B, settles_to("blank")))
action(B, pose(UP81), recv(M, "F5 02"), recv(B, "F5 1E"), display(B, settles_to("dashboard")))
# display mode 0x0A: normal
action(B, send('2B'), recv(B, "2B 69 0A 06"))

# over the whole run
never("fatal")
never("boot", after=1)
