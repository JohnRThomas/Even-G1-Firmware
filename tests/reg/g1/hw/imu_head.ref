# The phone sets the head-up angle to 60 and 10 degrees and reads it back, and the head is moved through poses
# around that angle. The dashboard must open and close around the angle set: a larger angle needs more lift.

# Worn before the phone: the dashboard opens on both lenses.
# dashboard, unpaired
action(B, gesture("don"), display(B, settles_to("dashboard_unpaired")), within=6)
# The phone connects: the MTU accepted, then the link, worn and the charging state reported (8 s on a clean
# link, 11 with one stalled sync to the slave) and the dashboard redrawn with the app's clock, the mic streaming. The
# connection's own events are over before the next input.
action(B, phone_on(),
       recv(B, "4D C9"), recv(B, "F5 11"), recv(B, "F5 06"), recv(B, "F5 09"),
       # dashboard
       display(B, settles_to("dashboard")), audio(M, 2.5),
       within=11, label="phone_on")

# Level: head down, the dashboard closes on both lenses.
action(B, pose(LEVEL), recv(M, "F5 03"), recv(B, "F5 1F"), display(B, blank))
# 81 deg: head up, the dashboard opens on both, with the head-up status and the mic stream.
action(B, pose(UP81),
       recv(M, "F5 02"), recv(B, "F5 1E"), recv(M, "22 0A 00 00 01", count=at_least(1)), audio(M),
       # dashboard
       display(B, settles_to("dashboard")))
# Head-up angle 60 deg: acknowledged; the 81 deg pose is below that angle now, the detector re-evaluates it
# as head down and the dashboard closes. 0x32 reads 60 deg, enabled, back.
action(M, send('0B 3C 01'), recv(M, "0B C9"), recv(M, "F5 03"), recv(B, "F5 1F"), display(B, blank))
action(M, send('32'), recv(M, "32 6D 3C 01"))
# Level, then 70 and 81 deg: nothing (all below the angle).
action(B, pose(LEVEL), quiet(B, "F5"))
action(B, pose(UP70), quiet(B, "F5"))
action(B, pose(UP81), quiet(B, "F5"))
# Level again and head-up angle 10 deg, read back; 45 deg: nothing (still below the angle); 81 deg: head up, the
# dashboard opens.
action(B, pose(LEVEL), quiet(B, "F5"))
action(M, send('0B 0A 01'), recv(M, "0B C9"))
action(M, send('32'), recv(M, "32 6D 0A 01"))
action(B, pose(UP45), quiet(B, "F5"))
action(B, pose(UP81),
       recv(M, "F5 02"), recv(B, "F5 1E"), recv(M, "22 0A 00 00 01", count=at_least(1)), audio(M),
       # dashboard
       display(B, settles_to("dashboard")))

# over the whole run
never("fatal")
never("boot", after=1)
link_up()
# The dashboard is up (the don gesture) when the phone connects: redrawn with the app's clock, and the
# master streams the mic while it is up (until the level pose).
# dashboard
after("phone_on", display(B, shows("dashboard")), audio(M, 2.5), within=8)
# worn, once per lens
recv(B, "F5 06")
# the charging state, once per lens
recv(B, "F5 09")
