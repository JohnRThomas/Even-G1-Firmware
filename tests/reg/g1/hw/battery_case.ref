# With the phone on, the master is put in the charging case, the case reports its level and its lid closed and open,
# then the case is removed. The glasses must tell the app all of it with events for in the case, charging, case
# level, lid closed and worn again.

# from power-up
action(B, NPM + "BatteryVoltageMilliVolts 3900")

at(12)
action(B, phone_on(),
       recv(B, "4D C9"),
       # 3.9 V, 0 mA, 25 C
       recv(M, "2C 66 .. .. BD 80 19 01 06 07 01 06 07"),
       recv(S, "2C 66 .. .. BD 80 19 00 00 00 01 06 07"),
       # BLE paired
       recv(B, "F5 11"),
       within=8, label="phone_on")

# before the case: the PMIC charger is enabled and idle
check(M, "sysbus.twim1.npm1300 ChargingEnabled", equals="True")
check(M, "sysbus.twim1.npm1300 ChargerStatus", equals="0x01")

# into the case: field, VBUS and a charge current
action(M, [NFC + "RfEnableMailbox", "sysbus.saadc SetAnalogInput 3 600000", NFC + "RfField true",
         NPM + "VbusConnected true", NPM + "BatteryCurrentMilliAmps -40"])

# the case says lid open, 55 % and charging: the firmware reports "in the case" on its next sensor-loop pass and
# answers the case with its own battery info (pt 0x13 reply: 53 % at 3.9 V); the other three events follow one
# per pass (about a second each)
wait(6)
action(M, case(0xB7, 7), recv(M, "F5 08"), within=2, label="case_open")
check(M, "sysbus.twim1.st25dv RfReadMailboxMessage", equals="13-01-02-06-00-17-70-35-01-27-00")
wait(0.7)
action(M, case(0xB7, 7))
action(M, case(0xB7, 7))
wait(3)
action(M, case(0xB7, 7))
# 2C 01: the status; debug string "#v": battery level, voltage, current and temperature, as text
action(M, [send('2C 01'), send('23 76')],
       # 0x58: -40 mA
       recv(M, "2C 66 .. .. BD 58 19"),
       recv(M, "'B:.., V:389, A:-40, T:25'"))
check(M, "sysbus.twim1.npm1300 ChargingEnabled", equals="True")
# charging
check(M, "sysbus.twim1.npm1300 ChargerStatus", equals="0x09")
action(M, case(0xB7, 7))

# lid closed; the case's charging flag drops (0xB7 -> 0x37) a few passes later
action(M, case(55, 6), recv(M, "F5 0B"), within=2, label="lid_closed")
action(M, case(55, 6))
wait(4.5)
check(M, "sysbus.twim1.st25dv RfReadMailboxMessage", equals="13-01-02-06-00-17-70-35-01-27-00")
action(M, case(55, 6))
action(M, case(55, 6))

# lid open again
action(M, case(55, 7), recv(M, "F5 08"), within=2)
action(M, case(55, 7))

# out of the case: worn again, not charging
action(M, [NFC + "RfField false", "sysbus.saadc SetAnalogInput 3 0", NPM + "VbusConnected false",
           NPM + "BatteryCurrentMilliAmps 0"],
       recv(M, "F5 06"), recv(M, "F5 09 00"),
       within=7)
check(M, "sysbus.twim1.npm1300 ChargingEnabled", equals="True")
check(M, "sysbus.twim1.npm1300 ChargerStatus", equals="0x01")
# the gauge takes six zero readings (one per sensor-loop pass) before it reports 0 mA; under the ESB defect the
# master's loop is slowed by its sync retries and has not got there 10 s after the case was removed
wait(9.2)
# 2C 01: the status; debug string "#v": battery level, voltage, current and temperature, as text
action(M, [send('2C 01'), send('23 76')],
       recv(M, "2C 66 .. .. BD 80 19"),
       recv(M, "'B:.., V:389, A:0, T:25'"))

# over the whole run
never("fatal")
never("boot", after=1)
link_up()
# worn, charging state: within 7 s on a clean link
after("phone_on", recv(B, "F5 06"), recv(B, "F5 09 00"), within=15)
# charging, case charging flag, case level 55 %
after("case_open", recv(M, "F5 09 01"), recv(M, "F5 0E 01"), recv(M, "F5 0F 37"), within=7)
# the case's charging flag drops
after("lid_closed", recv(M, "F5 0E 00"), within=12)
