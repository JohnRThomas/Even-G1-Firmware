# The ambient light sensor at 300 lux takes 15 s for its first conversion. The panel level must be reported once the
# conversion lands, and the debug query answers the lux base before and after.

action(M, [OPT + "Lux 300", OPT + "FaultConversionDelay 15000"])
# Worn before the phone: the dashboard opens on both lenses.
# dashboard, unpaired
action(B, gesture("don"), display(B, settles_to("dashboard_unpaired")), within=6)
# The phone connects (the MTU accepted here; the link, the dashboard and the mic stream are asserted over the
# whole run below).
action(B, phone_on(), recv(B, "4D C9"), within=3, label="phone_on")

# No result until the conversion is done.
check(M, "sysbus.twim1.opt3001 ResultRegister", equals="0x0000")
# debug string "#i": the light sensor's maximum lux, answered as text ("base: N")
action(M, send('23 69'), recv(M, "'base: 0'"))
# Brightness 12: acknowledged.
action(M, send('01 0C 00'), recv(M, "01 C9"))
check(M, "sysbus.twim1.opt3001 ResultRegister", equals="0x0000")
# The conversion lands 15 s after the sensor was started (with the panels, at the don gesture): the panel level is
# reported once (F5 12, level 0x0C); the register reads 0x3EA6 (300 lux) by then and #i answers base 3840.
expect(recv(M, "F5 12 0C"), within=18)
check(M, "sysbus.twim1.opt3001 ResultRegister", equals="0x3EA6")
# debug string "#i": the light sensor's maximum lux, answered as text ("base: N")
action(M, send('23 69'), recv(M, "'base: 3840'"))

# over the whole run
never("fatal")
never("boot", after=1)
link_up()
# The dashboard is up (the don gesture) when the phone connects: redrawn with the app's clock, and the
# master streams the mic while it is up.
# dashboard
after("phone_on", display(B, shows("dashboard")), audio(M, 5), within=8)
# worn, once per lens
recv(B, "F5 06")
# the charging state, once per lens
recv(B, "F5 09")
