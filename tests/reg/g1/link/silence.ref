# Neither phone writes anything after the first packets. The master must drop its Android phone after 30 s of
# silence and take its reconnection with the bond's key, while the slave never drops its iPhone for silence.

mark("phone_on")
# an Android phone without a heartbeat ...
action(M, phone_on(hb=0))
# ... and an iPhone without one
action(S, phone_on(os=2, hb=0))
expect(event(B, "pairing: complete, link encrypted, bonded"),
       recv(B, "4D C9"),
       recv(B, "2C 66"),
       # BLE paired
       recv(B, "F5 11"),
       # wear state reported on connect
       recv(B, "F5 06"),
       # charging state, within 8 s on a good schedule
       recv(B, "F5 09"),
       within=8)

# 30 s after the phone's last packets (the 0x4D/0x2C on connecting; checked every second) the lens closes the
# Android link ...
expect(event(M, "disconnected: the lens closed the link"), within=32)
mark("dropped")
# ... and the phone comes back at the next advertisement with the bond's key
expect(event(M, "connected to"),
       event(M, "link encrypted with the bond's key"),
       event(M, "Nordic UART Service: write"),
       within=6)
# paired again: the link is reported once the phone is back and the app has written the MTU (at least once)
action(M, send('4D FB'), recv(M, "4D C9"), recv(M, "F5 11", count=at_least(1)), within=6)
check(B, "sysbus.vcentral Connected", equals="True")
check(B, "sysbus.vcentral Encrypted", equals="True")
check(B, "sysbus.vcentral Bonded", equals="True")
check(B, "sysbus.vcentral AttMtu", equals="0x000000FB")

# over the whole run
never("fatal")
never("boot", after=1)
never("link dropped")
# the iOS link is kept
never("disconnected", lens=S)
# nothing dropped for 30 s after the last packet
after("phone_on", quiet(B, "disconnected"), within=30)
display(B, blank)
link_up()
# the charging state may be reported again on the master after the reconnect (seen under some seeds)
after("dropped", ignore("F5 09", lens=M), within=13)
