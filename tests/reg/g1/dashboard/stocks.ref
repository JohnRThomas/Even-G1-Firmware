# The app sends two stocks and two news items to the dashboard's stocks and news panes in both modes, and taps on
# the master page between them. Both lenses must acknowledge every chunk and redraw at each step.

at(12)
action(B, phone_on(),
       event(B, "pairing: complete, link encrypted, bonded"),
       recv(B, "2C 66"), recv(B, "4D C9"),
       # BLE paired
       recv(B, "F5 11"),
       within=8, label="phone_on")

# put on: both worn, the master head up, the dashboard opens on both lenses and the master streams the mic (F1)
# while it is up, which the app ignores
action(B, gesture("don"),
       recv(B, "F5 06"), recv(M, "F5 02"),
       # dashboard, "Loading"
       recv(B, "F5 1E"), display(B, settles_to("dashboard")), audio(M),
       within=6)

# the clock and the stocks pane in mode 1
# time and weather (sub 1): 14:35, weather icon 1, 20 C; dashboard layout (sub 6): mode 1, wide pane; pane 1, stocks
action(S, [send('06 16 00 01 01 14 9B 14 69 20 C6 7D 78 9A 01 00 00 01 14 00 00 00'), send('06 07 00 02 06 01 01')], recv(S, "06 16 00 01 01 00"), recv(S, "06 07 00 02 06 00"))
# time and weather (sub 1): 14:35, weather icon 1, 20 C; dashboard layout (sub 6): mode 1, wide pane; pane 1, stocks
action(M, [send('06 16 00 01 01 14 9B 14 69 20 C6 7D 78 9A 01 00 00 01 14 00 00 00'), send('06 07 00 02 06 01 01')], recv(M, "06 16 00 01 01 00"), recv(M, "06 07 00 02 06 00"),
       # mode 1, stocks Loading
       display(B, settles_to("stocks_loading")), within=1.5)

# stock 1 (GME): the 11 chunks go to each lens in one burst, each acknowledged with its header echoed, the first
# and the last in order
action(S, buf('stock_gme', 1, 11),
       recv(S, "06 .. 00 .. 04 0B 00", count=11),
       sequence(recv(S, "06 .. 00 .. 04 0B 00 01 00 00"), recv(S, "06 .. 00 .. 04 0B 00 0B 00 00")), within=1.5)
action(M, buf('stock_gme', 1, 11),
       recv(M, "06 .. 00 .. 04 0B 00", count=11),
       sequence(recv(M, "06 .. 00 .. 04 0B 00 01 00 00"), recv(M, "06 .. 00 .. 04 0B 00 0B 00 00")),
       # GME.XNYS 1/1, GameStop Corp, chart, 21.36 -0.09 -0.42%
       display(B, settles_to("stocks_gme_1of1")), within=2)

# stock 2 (AAPL): the list has two pages, the tap shows the second
action(S, buf('stock_aapl', 1, 11),
       recv(S, "06 .. 00 .. 04 0B 00", count=11),
       sequence(recv(S, "06 .. 00 .. 04 0B 00 01 00 00"), recv(S, "06 .. 00 .. 04 0B 00 0B 00 00")), within=1.5)
action(M, buf('stock_aapl', 1, 11),
       recv(M, "06 .. 00 .. 04 0B 00", count=11),
       sequence(recv(M, "06 .. 00 .. 04 0B 00 01 00 00"), recv(M, "06 .. 00 .. 04 0B 00 0B 00 00")),
       # GME.XNYS 1/2
       display(B, settles_to("stocks_gme_1of2")), within=2.5)
# AAPL.XNAS 2/2, Apple Inc, 270.10 +1.25 +0.46%
action(M, TAP, recv(M, "22 08 00 00 02 01 01 02"), display(B, settles_to("stocks_aapl_2of2")), within=1.5)

# mode 0 with the stocks pane, then mode 1 with the news pane
# dashboard layout (sub 6): mode 0, clock and pane; pane 1, stocks
action(S, send('06 07 00 28 06 00 01'), recv(S, "06 07 00 28 06 00"))
# mode 0, AAPL.XNAS 2/2 in the right pane
action(M, send('06 07 00 28 06 00 01'), recv(M, "06 07 00 28 06 00"), display(B, settles_to("stocks_mode0_aapl_2of2")), within=1.5)
# dashboard layout (sub 6): mode 1, wide pane; pane 2, news
action(S, send('06 07 00 29 06 01 02'), recv(S, "06 07 00 29 06 00"))
# mode 1, news Loading
action(M, send('06 07 00 29 06 01 02'), recv(M, "06 07 00 29 06 00"), display(B, settles_to("news_loading")), within=1)

# two news items, one chunk each
# news item 1 (sub 5): CBS News, "Sunny afternoon with a light wind from the west, highs near 20 degrees."
action(S, send('06 62 00 2A 05 01 00 01 00 01 02 02 01 01 01 08 43 42 53 20 4E 65 77 73 02 47 00 53 75 6E 6E 79 20 61 66 74 65 72 6E 6F 6F 6E 20 77 69 74 68 20 61 20 6C 69 67 68 74 20 77 69 6E 64 20 66 72 6F 6D 20 74 68 65 20 77 65 73 74 2C 20 68 69 67 68 73 20 6E 65 61 72 20 32 30 20 64 65 67 72 65 65 73 2E'),
       recv(S, "06 62 00 2A 05 01 00 01 00 00"))
# news item 1 (sub 5): CBS News, "Sunny afternoon with a light wind from the west, highs near 20 degrees."
action(M, send('06 62 00 2A 05 01 00 01 00 01 02 02 01 01 01 08 43 42 53 20 4E 65 77 73 02 47 00 53 75 6E 6E 79 20 61 66 74 65 72 6E 6F 6F 6E 20 77 69 74 68 20 61 20 6C 69 67 68 74 20 77 69 6E 64 20 66 72 6F 6D 20 74 68 65 20 77 65 73 74 2C 20 68 69 67 68 73 20 6E 65 61 72 20 32 30 20 64 65 67 72 65 65 73 2E'),
       # CBS News: Sunny afternoon...
       recv(M, "06 62 00 2A 05 01 00 01 00 00"), display(B, settles_to("news_cbs_only")), within=1.5)
# news item 2 (sub 5): BBC, "Second headline of the day for the news pane of the regression test."
action(S, send('06 5A 00 2B 05 01 00 01 00 01 02 02 02 01 01 03 42 42 43 02 44 00 53 65 63 6F 6E 64 20 68 65 61 64 6C 69 6E 65 20 6F 66 20 74 68 65 20 64 61 79 20 66 6F 72 20 74 68 65 20 6E 65 77 73 20 70 61 6E 65 20 6F 66 20 74 68 65 20 72 65 67 72 65 73 73 69 6F 6E 20 74 65 73 74 2E'),
       recv(S, "06 5A 00 2B 05 01 00 01 00 00"))
# news item 2 (sub 5): BBC, "Second headline of the day for the news pane of the regression test."
action(M, send('06 5A 00 2B 05 01 00 01 00 01 02 02 02 01 01 03 42 42 43 02 44 00 53 65 63 6F 6E 64 20 68 65 61 64 6C 69 6E 65 20 6F 66 20 74 68 65 20 64 61 79 20 66 6F 72 20 74 68 65 20 6E 65 77 73 20 70 61 6E 65 20 6F 66 20 74 68 65 20 72 65 67 72 65 73 73 69 6F 6E 20 74 65 73 74 2E'),
       # CBS News 1/2
       recv(M, "06 5A 00 2B 05 01 00 01 00 00"), display(B, settles_to("news_cbs_1of2")), within=1.5)
# BBC 2/2: Second headline...
action(M, TAP, recv(M, "22 08 00 00 02 01 02 02"), display(B, settles_to("news_bbc_2of2")), within=1.5)

# mode 0 with the news pane; the tap pages back to the first item
# dashboard layout (sub 6): mode 0, clock and pane; pane 2, news
action(S, send('06 07 00 2C 06 00 02'), recv(S, "06 07 00 2C 06 00"))
# mode 0, BBC 2/2 in the right pane
action(M, send('06 07 00 2C 06 00 02'), recv(M, "06 07 00 2C 06 00"), display(B, settles_to("news_mode0_bbc_2of2")), within=1.5)
# mode 0, CBS News 1/2
action(M, TAP, recv(M, "22 08 00 00 02 00 02 01"), display(B, settles_to("news_mode0_cbs_1of2")), within=1.5)

# head down: the master reports it, the dashboard closes on both lenses; head up: it reopens with the last
# content and the mic streams again
action(B, gesture("head_down"), recv(M, "F5 03"), recv(B, "F5 1F"), display(B, blank), within=2)
action(B, gesture("head_up"), recv(M, "F5 02"), recv(B, "F5 1E"), audio(M),
       # mode 0, CBS News 1/2
       display(B, settles_to("news_mode0_cbs_1of2")), within=2.5)

# over the whole run
never("fatal")
never("boot", after=1)
link_up()
# the charging state, reported once per lens
recv(B, "F5 09")
# the dashboard opened twice per lens
recv(B, "F5 1E", count=2)
audio(M)
