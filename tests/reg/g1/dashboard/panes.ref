# With the dashboard up and the clock set, the app walks through every pane layout, tapping the master after each.
# Both lenses must acknowledge each request and redraw, and the tap makes the master report its status except on the
# map pane.

action(B, phone_on(),
       event(B, "pairing: complete, link encrypted, bonded"),
       recv(B, "2C 66"), recv(B, "4D C9"),
       # BLE paired
       recv(B, "F5 11"),
       within=8, label="phone_on")

# put on: both worn, the master head up, the dashboard opens on both lenses and the master streams the mic (F1)
# while it is up, which the app ignores
action(B, gesture("don"),
       recv(B, "F5 06"), recv(M, "F5 02"),
       # dashboard, "Loading"
       recv(B, "F5 1E"), display(B, settles_to("dashboard")), audio(M),
       within=6)

# the clock: 14:35 Wed 11/12, icon 1 (moon), 20 C, with the QuickNote pane up
# time and weather (sub 1): 14:35, weather icon 1, 20 C
action(S, send('06 16 00 01 01 14 9B 14 69 20 C6 7D 78 9A 01 00 00 01 14 00 00 00'), recv(S, "06 16 00 01 01 00"))
# 14:35, moon 20 C, QuickNote
action(M, send('06 16 00 01 01 14 9B 14 69 20 C6 7D 78 9A 01 00 00 01 14 00 00 00'), recv(M, "06 16 00 01 01 00"), display(B, settles_to("dashboard_1435")), within=1.5)

# the panes: each acknowledged, each drawn on both lenses, the tap reported by the master
# dashboard layout (sub 6): mode 0, clock and pane; pane 0, QuickNote
action(S, send('06 07 00 02 06 00 00'), recv(S, "06 07 00 02 06 00"))
# pane 0 (QuickNote hint): the screen is already this one
action(M, send('06 07 00 02 06 00 00'), recv(M, "06 07 00 02 06 00"), display(B, settles_to("dashboard_1435")), within=1.5)
action(M, TAP, recv(M, "22 08 00 00 02 00 00 01"), within=1.5)
# dashboard layout (sub 6): mode 0, clock and pane; pane 1, stocks
action(S, send('06 07 00 03 06 00 01'), recv(S, "06 07 00 03 06 00"))
# mode 0, stocks pane Loading
action(M, send('06 07 00 03 06 00 01'), recv(M, "06 07 00 03 06 00"), display(B, settles_to("stocks_mode0_loading")), within=1.5)
action(M, TAP, recv(M, "22 08 00 00 02 00 01 01"), within=1.5)
# dashboard layout (sub 6): mode 0, clock and pane; pane 2, news
action(S, send('06 07 00 04 06 00 02'), recv(S, "06 07 00 04 06 00"))
# mode 0, news pane Loading
action(M, send('06 07 00 04 06 00 02'), recv(M, "06 07 00 04 06 00"), display(B, settles_to("news_mode0_loading")), within=1.5)
action(M, TAP, recv(M, "22 08 00 00 02 00 02 01"), within=1.5)
# dashboard layout (sub 6): mode 0, clock and pane; pane 3, calendar
action(S, send('06 07 00 05 06 00 03'), recv(S, "06 07 00 05 06 00"))
# mode 0, calendar pane (empty)
action(M, send('06 07 00 05 06 00 03'), recv(M, "06 07 00 05 06 00"), display(B, settles_to("dashboard_mode0_pane_empty")), within=1.5)
action(M, TAP, recv(M, "22 08 00 00 02 00 03 01"), within=1.5)
# dashboard layout (sub 6): mode 0, clock and pane; pane 4, map
action(S, send('06 07 00 06 06 00 04'), recv(S, "06 07 00 06 06 00"))
# mode 0, map pane Loading
action(M, send('06 07 00 06 06 00 04'), recv(M, "06 07 00 06 06 00"), display(B, settles_to("map_mode0_loading")), within=1.5)
# a tap on the map pane: no status report
action(M, TAP, quiet(M, "22 08"), within=1.5)
# dashboard layout (sub 6): mode 0, clock and pane; pane 5, empty
action(S, send('06 07 00 07 06 00 05'), recv(S, "06 07 00 07 06 00"))
# mode 0, pane 5 (empty, as the calendar pane)
action(M, send('06 07 00 07 06 00 05'), recv(M, "06 07 00 07 06 00"), display(B, settles_to("dashboard_mode0_pane_empty")), within=1.5)
action(M, TAP, recv(M, "22 08 00 00 02 00 05 00"), within=1.5)
# dashboard layout (sub 6): mode 1, wide pane; pane 0, QuickNote
action(S, send('06 07 00 08 06 01 00'), recv(S, "06 07 00 08 06 00"))
# mode 1, QuickNote hint, weather under the clock
action(M, send('06 07 00 08 06 01 00'), recv(M, "06 07 00 08 06 00"), display(B, settles_to("dashboard_mode1_quicknote")), within=1.5)
action(M, TAP, recv(M, "22 08 00 00 02 01 00 01"), within=1.5)
# dashboard layout (sub 6): mode 1, wide pane; pane 1, stocks
action(S, send('06 07 00 09 06 01 01'), recv(S, "06 07 00 09 06 00"))
# mode 1, stocks Loading
action(M, send('06 07 00 09 06 01 01'), recv(M, "06 07 00 09 06 00"), display(B, settles_to("stocks_loading")), within=1.5)
action(M, TAP, recv(M, "22 08 00 00 02 01 01 01"), within=1.5)
# dashboard layout (sub 6): mode 1, wide pane; pane 2, news
action(S, send('06 07 00 0A 06 01 02'), recv(S, "06 07 00 0A 06 00"))
# mode 1, news Loading
action(M, send('06 07 00 0A 06 01 02'), recv(M, "06 07 00 0A 06 00"), display(B, settles_to("news_loading")), within=1.5)
action(M, TAP, recv(M, "22 08 00 00 02 01 02 01"), within=1.5)
# dashboard layout (sub 6): mode 1, wide pane; pane 3, calendar
action(S, send('06 07 00 0B 06 01 03'), recv(S, "06 07 00 0B 06 00"))
# mode 1, calendar Loading
action(M, send('06 07 00 0B 06 01 03'), recv(M, "06 07 00 0B 06 00"), display(B, settles_to("calendar_loading")), within=1.5)
action(M, TAP, recv(M, "22 08 00 00 02 01 03 01"), within=1.5)
# dashboard layout (sub 6): mode 1, wide pane; pane 4, map
action(S, send('06 07 00 0C 06 01 04'), recv(S, "06 07 00 0C 06 00"))
# mode 1, map Loading
action(M, send('06 07 00 0C 06 01 04'), recv(M, "06 07 00 0C 06 00"), display(B, settles_to("map_loading")), within=1.5)
# a tap on the map pane: no status report
action(M, TAP, quiet(M, "22 08"), within=1.5)
# dashboard layout (sub 6): mode 1, wide pane; pane 5, empty
action(S, send('06 07 00 0D 06 01 05'), recv(S, "06 07 00 0D 06 00"))
# mode 1, pane 5 (empty)
action(M, send('06 07 00 0D 06 01 05'), recv(M, "06 07 00 0D 06 00"), display(B, settles_to("dashboard_mode1_pane_empty")), within=1.5)
action(M, TAP, recv(M, "22 08 00 00 02 01 05 00"), within=1.5)
# dashboard layout (sub 6): mode 2, clock only
action(S, send('06 07 00 0E 06 02 00'), recv(S, "06 07 00 0E 06 00"))
# mode 2: the clock alone, centred
action(M, send('06 07 00 0E 06 02 00'), recv(M, "06 07 00 0E 06 00"), display(B, settles_to("dashboard_mode2_clock_only")), within=1.5)
action(M, TAP, recv(M, "22 08 00 00 02 02 00 01"), within=1.5)

# head down: the master reports it, the dashboard closes on both lenses; head up: it reopens with the last
# content and the mic streams again
action(B, gesture("head_down"), recv(M, "F5 03"), recv(B, "F5 1F"), display(B, blank), within=2)
action(B, gesture("head_up"), recv(M, "F5 02"), recv(B, "F5 1E"), audio(M),
       # the clock alone
       display(B, settles_to("dashboard_mode2_clock_only")), within=2.5)

# over the whole run
never("fatal")
# no reboot (the PMIC watchdog under the bad schedule)
never("boot", after=1)
link_up()
# the charging state, reported once per lens
recv(B, "F5 09")
# the dashboard opened twice per lens
recv(B, "F5 1E", count=2)
audio(M)
