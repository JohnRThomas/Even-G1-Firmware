# The app stores a quick note, the user looks up and down again, then the app pushes the note update task. The
# dashboard must open with the note, and the task's prompt shows for 4 s.

# the session: the head down follows the don at once and takes its place, so the glasses are worn with the head
# level and no dashboard is up when the phone connects with the app's heartbeat off; the app's 0x2C
# keep-alive is sent by the lines below
action(B, gesture("don"))
action(B, gesture("head_down"))
action(B, phone_on(hb=0),
       event(B, "pairing: complete, link encrypted, bonded"),
       recv(B, "2C 66"), recv(B, "4D C9"),
       # the link event once per lens (link_up times it)
       recv(B, "F5 11"),
       within=8, label="phone_on")

# the note is acknowledged with the header echoed and status 0; nothing is shown (the dashboard is closed)
# QuickNote add (sub 3): "testing Your", "Oh wow" (tests/unit/vectors: 0x1e_quicknote_add)
action(B, send('1E 20 00 11 03 01 00 01 00 01 01 0C 74 65 73 74 69 6E 67 20 59 6F 75 72 06 00 4F 68 20 77 6F 77'), recv(B, "1E 20 00 11 03 01 00 01 00 00"), within=1)

# head up: the master reports it, the dashboard opens on both lenses with the note (F5 1E to the app, the
# 0x22 status), and the master streams the mic while the dashboard is up
action(B, gesture("head_up"),
       recv(M, "F5 02"), recv(B, "F5 1E"),
       recv(M, "22 0A 00 00 01", count=at_least(1)),
       # dashboard with the quick note
       display(B, settles_to("dashboard_quicknote")),
       audio(M),
       within=3, label="head_up")
# the 10 s keep-alive is answered with the status
action(B, send('2C 01'), recv(B, "2C 66"))

# head down: the master reports it, the dashboard closes on both lenses
action(B, gesture("head_down"),
       recv(M, "F5 03"), recv(B, "F5 1F"), display(B, blank),
       within=2)

# the note update task is acknowledged; its prompt shows on both lenses for 4 s, then they blank
action(B, send('51 06 00 30 01 01'),
       recv(B, "51 06 00 30 01 C9"),
       # "Please set a destination first."
       display(B, settles_to("quicknote_prompt")),
       within=1)
expect(display(B, blank), within=6)
action(B, send('2C 01'), recv(B, "2C 66"))

# over the whole run
never("fatal")
never("boot", after=1)
link_up()
# worn (donned before the phone), reported once
recv(B, "F5 06")
# the charging state, reported once
recv(B, "F5 09")
# head up, reported once
recv(M, "F5 02")
# head down, reported once
recv(M, "F5 03")
# dashboard closed, once
recv(B, "F5 1F")
# the mic streams while the dashboard is up, from the head up to the head down (1 s or more)
after("head_up", audio(M, 1), within=3)
