# With the glasses worn and the phone on, the slave is rebooted. It must come back, take the phone's reconnection
# with the bond's key and bind to the master over ESB again, while the master keeps its link and dashboard
# throughout.

# unpaired dashboard
action(B, gesture("don"), display(B, settles_to("dashboard_unpaired")), within=6)

at(12)
action(B, phone_on(hb=0),
       recv(B, "4D C9"),
       recv(M, "2C 66 .. .. F9 80 19 01 06 07 01 06 07"),
       recv(S, "2C 66 .. .. F9 80 19 00 00 00 01 06 07"),
       # BLE paired
       recv(B, "F5 11"),
       # dashboard
       display(B, settles_to("dashboard")),
       # worn, reported before the slave's reboot
       recv(B, "F5 06"),
       within=6, label="phone_on")

# the reboot: the link drops, both cores boot, the panel is cleared
# debug string "#r": reboot the lens
action(S, send('23 72'),
       event(S, "link dropped: the lens was reset"),
       event(S, "boot app"), event(S, "boot net"),
       display(S, settles_to("blank")),
       within=1, label="reboot")
# the phone reconnects with the bond and the slave answers its MTU and info requests
action(S, [send('4D FB'), send('2C 01')],
       event(S, "link encrypted with the bond's key"),
       recv(S, "4D C9"),
       recv(S, "2C 66 .. .. F9 80 19 00 00 00 01 06 07"))
# the master's keep-alives
action(M, send('2C 01'), recv(M, "2C 66 .. .. F9 80 19"))
wait(10.5)
# worn again: the wear state went with the reboot
action(S, gesture("don"))
# the slave's keep-alives
action(S, send('2C 01'), recv(S, "2C 66 .. .. F9 80 19"))
action(M, send('2C 01'), recv(M, "2C 66 .. .. F9 80 19"))
action(S, send('2C 01'), recv(S, "2C 66 .. .. F9 80 19"))
action(M, send('2C 01'), recv(M, "2C 66 .. .. F9 80 19"))

# over the whole run
never("fatal")
never("boot", after=1, lens=M)
# one reboot of the slave, no more
never("boot", after=("reboot", 1), lens=S)
link_up()
# the master's bring-up: worn, charging state
after("phone_on", recv(M, "F5 06"), recv(M, "F5 09 00"), within=15)
# whether the slave also gets to its charging-state report before the reboot depends on the schedule
after("phone_on", ignore("F5 09 00", lens=S), within=6)
# the ESB link again: the slave binds about 11 s after the reboot (the firmware's 10 s start-up hold), then its
# events follow (worn after 2 s, the charging state after 4 s on a clean link; up to 21 s when the master's sync
# retries slow the slave's loop)
after("reboot", recv(S, "F5 11"), within=12)
after("reboot", recv(S, "F5 06"), recv(S, "F5 09 00"), within=22)
# the slave's panel stays blank after its reboot (the master does not redraw it); the master streams mic audio
# (0xF1) while its dashboard is up, not what this scenario tests
ignore("audio", lens=M)
