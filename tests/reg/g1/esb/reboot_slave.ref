# With the glasses worn and the phone on, the slave is rebooted. It must come back, take the phone's reconnection
# with the bond's key and bind to the master over ESB again, while the master keeps its link and dashboard
# throughout.

action(B, phone_on(hb=0),
       recv(B, "4D C9"),
       # the master's own version: this soon after power-on it has not got the slave's yet (hw/battery_sweep
       # asserts both)
       recv(M, "2C 66 .. .. F9 80 19 01 06 07"),
       recv(S, "2C 66 .. .. F9 80 19 00 00 00 01 06 07"),
       # BLE paired
       recv(B, "F5 11"),
       within=8, label="phone_on")

# Turn off the mic on head up.
action(B, send('26 06 00 00 08 01'), recv(B, "26 06 00 .. 08 C9"))

# put on: head up, the dashboard opens on both lenses; worn and the charging state, reported before the slave's
# reboot
action(B, gesture("don"),
       recv(M, "F5 02"),
       recv(B, "F5 1E"),
       recv(B, "F5 06"),
       recv(B, "F5 09 00"),
       # dashboard
       display(B, settles_to("dashboard")),
       within=6)

# the reboot: the link drops, both cores boot, the panel is cleared
# debug string "#r": reboot the lens
action(S, send('23 72'),
       event(S, "link dropped: the lens was reset"),
       event(S, "boot app"), event(S, "boot net"),
       display(S, settles_to("blank")),
       within=1, label="reboot")
# the phone reconnects with the bond and the slave answers its MTU and info requests
action(S, [send('4D FB'), send('2C 01')],
       event(S, "link encrypted with the bond's key"),
       recv(S, "4D C9"),
       recv(S, "2C 66 .. .. F9 80 19 00 00 00 01 06 07"))
# the master's keep-alives
action(M, send('2C 01'), recv(M, "2C 66 .. .. F9 80 19"))
# the ESB link again: the slave reports the link once it is bound to the master, within 12 s of its reboot
# (counted from the reboot: the report may have come while the lines above ran)
expect(after("reboot", recv(S, "F5 11"), within=12), within=12)
# worn again: the wear state went with the reboot
action(S, gesture("don"))
# the slave's keep-alives
action(S, send('2C 01'), recv(S, "2C 66 .. .. F9 80 19"))
action(M, send('2C 01'), recv(M, "2C 66 .. .. F9 80 19"))
action(S, send('2C 01'), recv(S, "2C 66 .. .. F9 80 19"))
action(M, send('2C 01'), recv(M, "2C 66 .. .. F9 80 19"))

# over the whole run
never("fatal")
never("boot", after=1, lens=M)
# one reboot of the slave, no more
never("boot", after=("reboot", 1), lens=S)
link_up()
# once the slave is bound again (about 3.5 s after the reboot) its events follow: worn about 1.3 s later, the
# charging state about 3.7 s later on a clean link; up to 21 s after the reboot when the master's sync retries
# slow the slave's loop
after("reboot", recv(S, "F5 06"), recv(S, "F5 09 00"), within=22)
