# The app sends the dashboard pane, the clock, a text page, exit and a display sync to the master only. The slave
# must show the dashboard with the master's date and time, and the master acks the text only once the slave has it
# over ESB. A notification sent to and cleared on the slave only must be counted the same on both lenses, and the
# long press setting sent to the master only must read back the same on both.

action(B, phone_on(hb=0),
       recv(B, "4D C9"),
       # the master's own version: this soon after power-on it has not got the slave's yet (hw/battery_sweep
       # asserts both)
       recv(M, "2C 66 .. .. F9 80 19 01 06 07"),
       recv(S, "2C 66 .. .. F9 80 19 00 00 00 01 06 07"),
       # BLE paired
       recv(B, "F5 11"),
       within=8, label="phone_on")

# Turn off the mic on head up.
action(B, send('26 06 00 00 08 01'), recv(B, "26 06 00 .. 08 C9"))

# to the master only
action(M, send('06 16 00 06 01 F0 7E 14 69 80 D9 0F 78 9A 01 00 00 00 14 00 00 00'),
       # clock set acked
       recv(M, "06 16 00 06 01 00"))

# put on: head up, the dashboard opens on both lenses with the app's clock (Wed 11/12 12:35); the master
# streams mic audio (0xF1) from the moment its dashboard opens, not what this scenario tests
action(B, gesture("don"),
       recv(M, "F5 02"),
       recv(B, "F5 1E"),
       recv(B, "F5 06"),
       recv(B, "F5 09 00"),
       # dashboard, app clock at 12:35
       display(B, settles_to("dashboard_clock")),
       within=6)

# text to the master: acked once the slave has it, the dashboard closes, the master shows the text and the
# slave keeps its dashboard
# text page (0x4E, style 7), to the master only: "Text sent to the master lens only."
action(M, send('4E 07 01 00 71 00 00 01 01 54 65 78 74'),
       recv(M, "4E C9 07 01"), recv(M, "F5 1F"),
       # "Text sent to the master lens only."
       display(M, settles_to("text_master_only")),
       display(S, settles_to("dashboard_clock")))

# exit: both panels clear (the exit is reported as F5 00), then the dashboard returns as the head is still up
action(M, send('18'),
       recv(M, "18 C9"), recv(M, "F5 00"),
       recv(S, "F5 1F"), recv(B, "F5 1E"))

# a notification to the slave only: the master reports it pending once the slave has passed it over ESB, and
# both lenses then count one unread
# notification whitelist: Chat (a notification from an app not in it is not kept)
action(S, send('04 01 00 7B 22 63 61 6C 65 6E 64 61 72 5F 65 6E 61 62 6C 65 22 3A 74 72 75 65 2C 22 63 61 6C 6C 5F 65 6E 61 62 6C 65 22 3A 74 72 75 65 2C 22 6D 73 67 5F 65 6E 61 62 6C 65 22 3A 74 72 75 65 2C 22 69 6F 73 5F 6D 61 69 6C 5F 65 6E 61 62 6C 65 22 3A 74 72 75 65 2C 22 61 70 70 22 3A 7B 22 6C 69 73 74 22 3A 5B 7B 22 69 64 22 3A 22 63 6F 6D 2E 65 78 61 6D 70 6C 65 2E 63 68 61 74 22 2C 22 6E 61 6D 65 22 3A 22 43 68 61 74 22 7D 5D 2C 22 65 6E 61 62 6C 65 22 3A 74 72 75 65 7D 7D'), recv(S, "04 C9"))
# notification 11 from Chat in two chunks: "Auto display on", "This one pops up while you look down."
action(S, [send('4B 00 02 00 7B 22 6E 63 73 5F 6E 6F 74 69 66 69 63 61 74 69 6F 6E 22 3A 7B 22 6D 73 67 5F 69 64 22 3A 31 31 2C 22 61 63 74 69 6F 6E 22 3A 30 2C 22 61 70 70 5F 69 64 65 6E 74 69 66 69 65 72 22 3A 22 63 6F 6D 2E 65 78 61 6D 70 6C 65 2E 63 68 61 74 22 2C 22 74 69 74 6C 65 22 3A 22 41 75 74 6F 20 64 69 73 70 6C 61 79 20 6F 6E 22 2C 22 73 75 62 74 69 74 6C 65 22 3A 22 22 2C 22 6D 65 73 73 61 67 65 22 3A 22 54 68 69 73 20 6F 6E 65 20 70 6F 70 73 20 75 70 20 77 68 69 6C 65 20 79 6F 75 20 6C 6F 6F 6B 20 64 6F 77 6E 2E 22 2C 22 74 69 6D 65 5F'), send('4B 00 02 01 73 22 3A 31 37 36 32 38 39 39 39 35 39 2C 22 64 61 74 65 22 3A 22 32 30 32 35 2D 31 31 2D 31 31 20 32 32 3A 32 35 3A 35 39 22 2C 22 64 69 73 70 6C 61 79 5F 6E 61 6D 65 22 3A 22 43 68 61 74 22 7D 7D')],
       sequence(recv(S, "4B CB"), recv(S, "4B C9")))
# TODO: Don't ack the packet until the other frame confirms over ESB.
# The lens will ack the notification right away and sync it over later. Give it a chance to propogate.
wait(1.0)
action(B, send('36'), recv(B, "36 C9 01"))

# clearing it on the slave clears it on the master too
action(S, send('4C 00 00 00 0B'), recv(S, "4C C9"),
       # status: no message pending
       recv(M, "22 0A 00 .. 01 00"))
action(B, send('36'), recv(B, "36 C9 00"))

# long press off/on (Hardware Set 0x26, sub-command 07) to the master only: the master passes it on over ESB
action(B, send('3F 07'), recv(B, "3F 07 C9 00"))
action(M, send('26 06 00 00 07 01'), recv(M, "26 06 00 00 07 C9"))
action(B, send('3F 07'), recv(B, "3F 07 C9 01"))

# over the whole run
never("fatal")
never("boot", after=1)
