# The phone switches the microphone on and off on the master twice and on the slave once, with a sine and then
# silence as the input. Each request must be acknowledged and the audio stream runs only while the mic is on.

action(B, PDM + "ConfigureSine 8000 1000")
at(12)
action(B, phone_on(), recv(B, "4D C9"), recv(B, "F5 11"), within=8, label="phone_on")
# Master mic on at 16: acknowledged, the audio stream starts and runs until the mic off at 23 (through the
# silence from 20 s): the stream's length and its end are asserted over the whole run below, where the
# trace shows where a stream ended.
action(M, send('0E 01'), recv(M, "0E C9 01"), audio(M), within=1, label="mic_on")
action(M, PDM + "ConfigureSilence")
at(23)
action(M, send('0E 00'), recv(M, "0E C9 00"), within=1)
# Master mic on again at 26, off at 29.
at(26)
action(M, send('0E 01'), recv(M, "0E C9 01"), audio(M), within=1, label="mic_on")
at(29)
action(M, send('0E 00'), recv(M, "0E C9 00"), within=1)
# Slave mic on at 31: acknowledged, its own stream starts. The slave acknowledges the mic off at 34 but keeps
# streaming to the end of the run: dmic_stream_stop() only acts on the master (the app drives the right
# lens's mic only).
action(S, send('0E 01'), recv(S, "0E C9 01"), audio(S), within=1, label="mic_on")
at(34)
action(S, send('0E 00'), recv(S, "0E C9 00"), within=1)
wait(2)

# over the whole run
never("fatal")
never("boot", after=1)
link_up()
# never worn with the head up: the panels stay blank
display(B, blank)
# worn, once per lens
recv(B, "F5 06")
# the charging state, once per lens
recv(B, "F5 09")
# the first stream runs from 16 to the mic off at 23
after(("mic_on", 1), audio(M, 6), within=1)
# the stream's last packet is just before the mic off
after(22.5, event(M, "audio end"), within=1)
after(("mic_on", 2), audio(M, 2.5), within=1)
after(28.5, event(M, "audio end"), within=1)
# the slave's stream, to the end of the run
after(("mic_on", 3), audio(S, 6), within=1)
