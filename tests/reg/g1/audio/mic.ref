# The phone switches the microphone on and off on the master twice and on the slave once, with a sine and then
# silence as the input. Each request must be acknowledged and the audio stream runs only while the mic is on.

action(B, PDM + "ConfigureSine 8000 1000")
action(B, phone_on(), recv(B, "4D C9"), recv(B, "F5 11"), within=8, label="phone_on")
# Master mic on: acknowledged, the audio stream starts. It runs on while the mic is on: through 2 s of the sine
# and then through the silence, 6 s in all.
action(M, send('0E 01'), recv(M, "0E C9 01"), audio(M), within=1, label="mic_on")
expect(audio(M, 2, during=True), within=3)
action(M, PDM + "ConfigureSilence")
expect(audio(M, 6, during=True), within=5)
# Mic off: acknowledged, and the stream ends with it: its last packet comes at most 0.5 s after the request, and
# none in the 2 s after that.
action(M, send('0E 00'), recv(M, "0E C9 00"), within=1, label="mic_off")
expect(no_audio(M, after=(("mic_off", 1), 0.5)), within=2.5)
# Master mic on again: a second stream, 2.5 s of it; off again (its end is asserted over the whole run below).
action(M, send('0E 01'), recv(M, "0E C9 01"), audio(M), within=1, label="mic_on")
expect(audio(M, 2.5, during=True), within=3.5)
action(M, send('0E 00'), recv(M, "0E C9 00"), within=1, label="mic_off")
# Slave mic on: acknowledged, its own stream starts. The slave acknowledges the mic off but keeps streaming:
# dmic_stream_stop() only acts on the master (the app drives the right lens's mic only). Its stream is still
# running when it has lasted 6 s, most of them after the mic off.
action(S, send('0E 01'), recv(S, "0E C9 01"), audio(S), within=1, label="mic_on")
action(S, send('0E 00'), recv(S, "0E C9 00"), within=1)
expect(audio(S, 6, during=True), within=7)

# over the whole run
never("fatal")
never("boot", after=1)
link_up()
# never worn with the head up: the panels stay blank
display(B, blank)
# worn, once per lens
recv(B, "F5 06")
# the charging state, once per lens
recv(B, "F5 09")
# the first stream runs from the mic on to the mic off (it ends there: in line above)
after(("mic_on", 1), audio(M, 6), within=1)
# the second stream, and its end: the last packet at most 0.5 s after the mic off, none in the 2 s after that
after(("mic_on", 2), audio(M, 2.5), within=1)
after(("mic_off", 2), no_audio(M, after=(("mic_off", 2), 0.5)), within=2.5)
# the slave's stream, to the end of the run
after(("mic_on", 3), audio(S, 6), within=1)
