# The network core image is net_core/ (cmake/modules/mcuboot/CMakeLists.txt).  With
# network core DFU on and no RPMsg image selected, NCS adds an empty network core image
# to the same domain, which holds only one image.  NCS defines the option without a
# prompt, so it gets one here and prj.conf turns it off.
config NCS_SAMPLE_EMPTY_NET_CORE_CHILD_IMAGE
	bool "Add NCS's empty network core image"
	depends on SOC_NRF5340_CPUAPP && BOARD_ENABLE_CPUNET

source "Kconfig.zephyr"
