#include <dt-bindings/regulator/npm1300.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-adc.h>

/ {
	chosen {
		nordic,pm-ext-flash = &extflash;
	};
};

/*
 * G1 app-core board overlay — nrf5340dk_nrf5340_cpuapp
 *
 * nRF5340 SERIAL mapping:
 *   UARTE0=uart@8000  TWIM1=i2c@9000  SPIM3/SPIM4=projector(runtime pins)
 *   TWIM2=i2c@b000    PDM0=pdm@26000  QSPI=mx25r6435f
 * There is no PWM node (brightness is set over projector SPI).
 */

&pinctrl {
	/* ---- QSPI (external NOR flash) ---- */
	qspi_default: qspi_default {
		group1 {
			psels = <NRF_PSEL(QSPI_SCK, 0, 17)>,
				<NRF_PSEL(QSPI_IO0, 0, 13)>,
				<NRF_PSEL(QSPI_IO1, 0, 14)>,
				<NRF_PSEL(QSPI_IO2, 0, 15)>,
				<NRF_PSEL(QSPI_IO3, 0, 16)>,
				<NRF_PSEL(QSPI_CSN, 0, 18)>;
			nordic,drive-mode = <NRF_DRIVE_H0H1>;
		};
	};
	/* qspi_sleep: the DK default (CSN in its own pull-up group2) */

	/* ---- I2C1 (i2c@9000): OPT3007 ALS + PMIC ---- */
	i2c1_default: i2c1_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 5)>,
				<NRF_PSEL(TWIM_SCL, 0, 4)>;
		};
	};
	i2c1_sleep: i2c1_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 5)>,
				<NRF_PSEL(TWIM_SCL, 0, 4)>;
			low-power-enable;
		};
	};

	/* ---- I2C3 (i2c@b000): LSM6DSO IMU ---- */
	i2c2_default: i2c2_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,
				<NRF_PSEL(TWIM_SCL, 1, 3)>;
		};
	};
	i2c2_sleep: i2c2_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,
				<NRF_PSEL(TWIM_SCL, 1, 3)>;
			low-power-enable;
		};
	};

	/* ---- UARTE0 (uart@8000): console/debug ---- */
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 20)>,
				<NRF_PSEL_DISCONNECTED(UART_RTS)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 22)>,
				<NRF_PSEL_DISCONNECTED(UART_CTS)>;
			bias-pull-up;
		};
	};
	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 20)>,
				<NRF_PSEL(UART_RX, 0, 22)>;
			low-power-enable;
		};
	};

	/* ---- PDM0 (pdm@26000): microphone ---- */
	pdm0_default: pdm0_default {
		group1 {
			psels = <NRF_PSEL(PDM_CLK, 1, 13)>,
				<NRF_PSEL(PDM_DIN, 1, 14)>;
		};
	};

};

/* ================= peripheral nodes ================= */

&qspi {
	status = "okay";
	pinctrl-0 = <&qspi_default>;
	pinctrl-1 = <&qspi_sleep>;
	pinctrl-names = "default", "sleep";

	/*
	 * External serial NOR: a Macronix MX25U256-family (256 Mbit / 32 MiB)
	 * device.  The node keeps the DK's name "mx25r6435f@0", which is the
	 * Zephyr device name; the extflash label names it neutrally.
	 */
	extflash: mx25r6435f@0 {
		compatible = "nordic,qspi-nor";
		reg = <0>;
		writeoc = "pp4io";
		readoc = "read4io";
		/* the 96 MHz base clock undivided: HFCLK192M / 1, SCK divider 1 */
		sck-frequency = <96000000>;
		jedec-id = [c2 25 39];		/* MX25U256 */
		size = <268435456>;		/* 32 MiB */
		has-dpd;
	};
};

&i2c1 { /* i2c@9000 */
	compatible = "nordic,nrf-twim";
	status = "okay";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-1 = <&i2c1_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_FAST>;

	opt3007: opt3001@45 {
		compatible = "ti,opt3001";
		reg = <0x45>;
	};

	pmic: pmic@6b {
		compatible = "nordic,npm1300";
		reg = <0x6b>;

		pmic_gpio: gpio-controller {
			compatible = "nordic,npm1300-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <3>;
		};

		pmic_regulators: regulators {
			compatible = "nordic,npm1300-regulator";

			pmic_buck1: BUCK1 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
			};
			pmic_buck2: BUCK2 {
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <3300000>;
				regulator-init-microvolt = <1200000>;
			};
			pmic_ldo1: LDO1 {
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <3300000>;
				regulator-initial-mode = <NPM1300_LDSW_MODE_LDSW>;
			};
			pmic_ldo2: LDO2 {
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <3300000>;
				regulator-initial-mode = <NPM1300_LDSW_MODE_LDSW>;
			};
		};

		pmic_wdt: watchdog {
			compatible = "nordic,npm1300-wdt";
			/* PMIC GPIO2 is the watchdog reset output */
			reset-gpios = <&pmic_gpio 2 GPIO_ACTIVE_LOW>;
		};

		pmic_charger: charger {
			compatible = "nordic,npm1300-charger";
			term-microvolt = <4400000>;
			term-warm-microvolt = <4100000>;
			current-microamp = <40000>;
			dischg-limit-microamp = <1000000>;
			vbus-limit-microamp = <500000>;
			thermistor-ohms = <100000>;
			thermistor-beta = <4250>;
			charging-enable;
		};
	};
};

&i2c2 { /* i2c@b000 */
	compatible = "nordic,nrf-twim";
	status = "okay";
	pinctrl-0 = <&i2c2_default>;
	pinctrl-1 = <&i2c2_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_FAST>;

	lsm6dso: lsm6dso@6b {
		compatible = "st,lsm6dso";
		reg = <0x6b>;
		/* both sensors use the driver's low/normal-power mode; ODR/range
		 * stay at their power-up defaults */
		accel-pm = <1>;
		gyro-pm = <1>;
		status = "okay";
	};
};

&uart0 { /* uart@8000 */
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
	/* hw-flow-control omitted: RTS/CTS not routed */
};

&pdm0 { /* pdm@26000 */
	status = "okay";
	pinctrl-0 = <&pdm0_default>;
	pinctrl-names = "default";
};

/* Projector buses are configured at runtime through nrfx; SPIM3/SPIM4 have no
 * Zephyr SPI device. */
&spi4 { status = "disabled"; };
&spi3 { status = "disabled"; };

/* ================= GPIO control lines / buttons ================= */
/ {
	/* the DK push buttons are not on the glasses */
	/delete-node/ buttons;
	aliases {
		/delete-property/ sw0;
		/delete-property/ sw1;
		/delete-property/ sw2;
		/delete-property/ sw3;
		/delete-property/ mcuboot-button0;
	};

	gpio_keys {
		compatible = "gpio-keys";
		sw0: sw0 {
			gpios = <&gpio1 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "SW0";
		};
		sw1: sw1 {
			gpios = <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "SW1";
		};
	};

	panel_ctrl {
		compatible = "gpio-leds";
		panel_pwr: panel_pwr {
			gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
			label = "panel-power-enable";
		};
	};
};

/* audio clock: 12.288 MHz */
&clock {
	hfclkaudio-frequency = <12288000>;
};

&pdm0 {
	queue-size = <10>;
	clock-source = "PCLK32M";
};

/* NFC field voltage, read by nfc_wlc.c through io-channels */
/ {
	zephyr,user {
		io-channels = <&adc 3>;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN3>;
		zephyr,resolution = <12>;
	};
};

/* only P1.01 and P1.00 go to the network core; the DK default also forwards
 * P0.11/P0.10 */
&gpio_fwd {
	uart {
		gpios = <&gpio1 1 0>, <&gpio1 0 0>;
	};
};

/* CONFIG_NRFX_SPIS2 needs an SPIS-compatible node (it stays disabled) */
&spi2 {
	compatible = "nordic,nrf-spis";
	status = "disabled";
};
