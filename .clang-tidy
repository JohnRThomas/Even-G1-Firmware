---
# bugprone-tagged-union-member-count is off because it emits stray notes that make
# unrelated SDK header warnings pass the header filter.  readability-redundant-nested-if
# is off because its fixes fold side-effecting calls into compound conditions.
# bugprone-signed-char-misuse is off because plain char is unsigned on ARM and int8_t
# only holds numbers here.
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  -bugprone-narrowing-conversions,
  -bugprone-signed-bitwise,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -bugprone-switch-missing-default-case,
  -bugprone-unhandled-code-paths,
  -bugprone-tagged-union-member-count,
  -bugprone-signed-char-misuse,
  misc-*,
  -misc-include-cleaner,
  -misc-unused-parameters,
  -misc-use-internal-linkage,
  performance-*,
  concurrency-*,
  portability-*,
  -portability-no-assembler,
  readability-misleading-indentation,
  readability-redundant-*,
  -readability-redundant-nested-if,
  readability-non-const-parameter,
  readability-inconsistent-declaration-parameter-name,
  readability-duplicate-include,
  readability-else-after-return
WarningsAsErrors: '*'
CheckOptions:
  # Reported inside the SDK's own headers regardless of the header filter.
  misc-header-include-cycle.IgnoredFilesList: 'kernel\.h'
