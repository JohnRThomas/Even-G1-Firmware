---
# bugprone-tagged-union-member-count is off because it emits stray notes that make
# unrelated SDK header warnings pass the header filter.  bugprone-signed-char-misuse is
# off because plain char is unsigned on ARM and int8_t only holds numbers here.
# Kernel macros that define non-static objects (K_MSGQ_DEFINE, LOG_MODULE_REGISTER,
# K_THREAD_DEFINE) carry a NOLINT for misc-use-internal-linkage at the use.
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  -bugprone-narrowing-conversions,
  -bugprone-signed-bitwise,
  -bugprone-easily-swappable-parameters,
  -bugprone-tagged-union-member-count,
  -bugprone-signed-char-misuse,
  misc-*,
  -misc-include-cleaner,
  -misc-unused-parameters,
  performance-*,
  concurrency-*,
  portability-*,
  -portability-no-assembler,
  readability-misleading-indentation,
  readability-redundant-*,
  readability-non-const-parameter,
  readability-inconsistent-declaration-parameter-name,
  readability-duplicate-include,
  readability-else-after-return
WarningsAsErrors: '*'
CheckOptions:
  # Reported inside the SDK's own headers regardless of the header filter.
  misc-header-include-cycle.IgnoredFilesList: 'kernel\.h'
